      "evidence": { "kind": "source-audit", "status": "verified", "reference": "Sources/EluAnalytics/Elu.swift" }
    },
    {
      "id": "reset.fifo-and-metadata",
      "area": "reset",
      "given": { "state": "pending", "buffer": [] },
      "operations": ["capture(before)", "reset()", "capture(after)"],
      "expected": { "drainOrder": ["capture(before)", "reset()", "capture(after)"], "eluSuperPropertiesRestoredAfterReset": true },
      "evidence": { "kind": "source-audit", "status": "verified", "reference": "Sources/EluAnalytics/EluState.swift" }
    },
