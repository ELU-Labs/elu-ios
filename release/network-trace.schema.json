{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elu.dev/schemas/ios-sdk-network-trace-v1.json",
  "title": "ELU iOS SDK normalized network trace",
  "type": "object",
  "required": ["schemaVersion", "scenarios", "requests"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "enum": [
          "config",
          "capture",
          "identify",
          "reset",
          "flags",
          "replay",
          "background",
          "foreground",
          "offline-recovery"
        ]
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario", "url"],
        "properties": {
          "scenario": {
            "enum": [
              "config",
              "capture",
              "identify",
              "reset",
              "flags",
              "replay",
              "background",
              "foreground",
              "offline-recovery"
            ]
          },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "method": { "type": "string" },
          "requestHeaders": { "type": "object" },
          "requestBody": {},
          "responseHeaders": { "type": "object" },
          "responseBody": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
